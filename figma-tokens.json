      "secondary": { "value": "#7B7B7B", "type": "color", "description": "Muted secondary descriptive text" },
      "tertiary": { "value": "#A1A1AA", "type": "color", "description": "Subtle captions, borders, and timestamps" },
      "inverse": { "value": "#FFFFFF", "type": "color", "description": "White text on primary CTAs" }
